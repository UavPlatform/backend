:8888 {
	# WebSocket 通道（1A-3 / 修复 WEB P1-10）：/ws/web、/ws/drone、/ws/{sid} 统一走本路由。
	# 生产后端挂 /api 上下文（docker-compose: SERVER_SERVLET_CONTEXT_PATH=/api），
	# 故此处将 /ws 前缀重写为 /api/ws 后转发，前端 URL 保持 ws://host/ws/... 不变。
	# 鉴权头透传（1A-1 WS 协议）：Authorization: Bearer 请求头与 ?token= query
	# 均默认原样转发（Caddy v2 不剥离 Authorization；rewrite 保留 query string）。
	handle /ws/* {
		rewrite * /api{uri}
		reverse_proxy localhost:8081 {
			flush_interval -1
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}

	# 高德 JS API 安全代理（Web 端，GET /config/map 的 serviceHost 指向这里）：
	# securityKey（jscode）只存在于 Caddy 进程环境变量 AMAP_SECURITY_KEY，不下发给任何客户端。
	# 规则对应高德官方 nginx 示例：/_AMapService/v4/map/styles → webapi，/v3/vectormap → fmap01，其余 → restapi。
	handle_path /_AMapService/v4/map/styles* {
		rewrite * /v4/map/styles{path}?{query}&jscode={$AMAP_SECURITY_KEY}
		reverse_proxy https://webapi.amap.com
	}
	handle_path /_AMapService/v3/vectormap* {
		rewrite * /v3/vectormap{path}?{query}&jscode={$AMAP_SECURITY_KEY}
		reverse_proxy https://fmap01.amap.com
	}
	handle_path /_AMapService/* {
		rewrite * {path}?{query}&jscode={$AMAP_SECURITY_KEY}
		reverse_proxy https://restapi.amap.com
	}

	handle /api/* {
		reverse_proxy localhost:8081 {
			flush_interval -1
		}
	}

	handle {
		respond "Drone API Server" 200
	}
}
