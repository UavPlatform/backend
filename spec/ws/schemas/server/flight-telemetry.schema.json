{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persisted flight event pushed to web (ADR-0009, ADR-0014)",
  "type": "object",
  "required": [
    "type",
    "name",
    "deviceId",
    "timestamp",
    "data"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "name": {
      "const": "FLIGHT_TELEMETRY"
    },
    "deviceId": {
      "type": "string",
      "description": "aircraft serial number"
    },
    "timestamp": {
      "type": "integer",
      "description": "device capture time, epoch ms"
    },
    "data": {
      "type": "object",
      "description": "One accepted event from the committed projection. Sensor readings keep their own capture time; nothing is combined into a synthetic sample.",
      "required": [
        "orderId",
        "eventId",
        "changeSequence",
        "serialNumber",
        "serialSource",
        "type",
        "capturedAt",
        "receivedAt",
        "payload"
      ],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "changeSequence": {
          "type": "integer"
        },
        "serialNumber": {
          "type": "string"
        },
        "serialSource": {
          "type": "string",
          "description": "identity source token, e.g. FLIGHT_CONTROLLER"
        },
        "modelCode": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "POSITION / ALTITUDE / VELOCITY / BATTERY / ACTUAL_FLYING_STATE / ACTUAL_MOTOR_STATE / OPERATION_INTENT / OPERATION_RESULT / RECORDING_CUTOFF"
        },
        "capturedAt": {
          "type": "integer"
        },
        "receivedAt": {
          "type": "integer"
        },
        "payload": {
          "type": "object",
          "description": "Event-specific fields in contract units, e.g. latitudeDegE7/longitudeDegE7 for POSITION."
        }
      }
    }
  },
  "additionalProperties": true
}
