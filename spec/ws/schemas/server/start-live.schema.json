{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "START_LIVE command",
  "type": "object",
  "required": ["id", "type", "name", "deviceId", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "command" },
    "name": { "const": "START_LIVE" },
    "deviceId": { "type": "string" },
    "timestamp": { "type": "integer" },
    "data": {
      "type": "object",
      "required": ["roomId", "userId", "userSig"],
      "properties": {
        "roomId": { "type": "string" },
        "userId": { "type": "string" },
        "userSig": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
